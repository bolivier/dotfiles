;; TODO figure out why the icons are different in Emacs and on the bar

(defpoll TIME :interval "5s" `date +\"%I:%M %p\"`)
(defpoll DATE :interval "5s" `date +\"%A, %B %d\"`)

;; (defpoll BATICON :interval "1m" `scripts/battery --icon`)
;; (defpoll BATPERC :interval "1m" `scripts/battery --perc`)

;; (defpoll VOLICON :interval "1s" `scripts/volume --icon`)
;; (defpoll VOLUME :interval "1s" `scripts/volume --get`)

;; (defpoll WIFIICON :interval "10s" `scripts/check-network --icon`)
;; (defpoll NETSTAT :interval "10s" `scripts/check-network --stat`)



(defwindow bar
    :monitor 0
    :geometry (geometry :x       "0"
                        :y       "5px"
                        :width "100%")
    :stacking "fg"
    :windowtype "dock"
    :wm-ignore false

    (system))

(defwidget system []
  (box :hexpand true
   (box :halign "start"
        :hexpand true
        :class "left-adjacent"
    (workspace-list :active-workspace active-workspace))

   (box :class "right-adjacent"
        :halign "end"
        :space-evenly false
        :spacing 10

        (vpn-display :vpn vpn-data)

        (bluetooth-display)

        (volume-display :volume-data volume-data)

        (clock))))

(defpoll battery :interval "30s"
         :initial "{}"
         `scripts/battery.clj`)

(defwidget vpn-display [vpn]
    (box :class "pill"
         (eventbox :onclick "./scripts/vpn.clj toggle &"
                   :cursor "pointer"
                   vpn-data)))

(defpoll vpn-data :initial "{}"
                  :interval "5m"
                  `./scripts/vpn.clj`)

(deflisten volume-data :initial "{}"
           "scripts/volume.clj")

(deflisten workspaces :initial "[]"
           "scripts/visible_workspaces_listener.clj")

(deflisten active-workspace
           "scripts/event_updater_for_eww.clj")

(defpoll time :interval "1s"
  `date +'%a, %d %b, %I:%M %p'`)

(defwidget battery-display [battery]
  (box :class "pill battery"
       "${battery.percentage}% ${battery.icon}" ))

(defwidget clock []
 (box :class "clock pill"
      :hexpand "false"
      time))

(defwidget volume-display [volume-data]
  (box :class "pill volume"
       (eventbox :onscroll "scripts/volume.clj set {}"
         "${volume-data.amount}% ${volume-data.icon}")))

(defwidget workspace-list [active-workspace]
  (box :class "workspaces pill"
       :spacing 5
       (for ws in workspaces
            (eventbox :cursor "pointer"
              (button :class "workspace-button ${ws == active-workspace ? 'active' : 'inactive'}"
                      :onclick "hyprctl dispatch workspace ${ws}"
                "${ws}")))))

(defwidget bluetooth-display []
  (box :class "pill bluetooth-pill"
    (eventbox :onhover "eww open bluetooth-dropdown"
      current-bluetooth-device)))

(defvar bluetooth-open false)
(defvar poll-bluetooth true)
(defpoll current-bluetooth-device :interval "10s"
  `./scripts/bluetooth.clj current`)

(defpoll bluetooth-data :interval "1s"
         :run-while poll-bluetooth
         `eww update poll-bluetooth='false' && ./scripts/bluetooth.clj `)

(defwidget bluetooth-dropdown-content []
  (box :class "dropdown-content bluetooth-dropdown"
    (eventbox :onhoverlost "eww close bluetooth-dropdown"
      (box :orientation "v"
           :space-evenly false
        (box :class "devices-title" "Devices")
        (for data in bluetooth-data
          (box :class "bluetooth-entry"
               :space-evenly false
               :hexpand true
            (box :hexpand true
              (box :halign "start"
                "${data.name}"))
            (eventbox :cursor "pointer"
                      :width 25
                      :onclick {data.connected ? "./scripts/bluetooth.clj disconnect ${data.id} & "
                                               : "./scripts/bluetooth.clj connect    ${data.id} & "}
              {data.connected ? "" : "󱘖"})))))))

(defwindow bluetooth-dropdown
  :monitor   0
  :stacking  "overlay"
  :wm-ignore true
  :focusable false
  :geometry (geometry :x      "300px"
                      :y      "32px"
                      :width  220
                      :anchor "top right")
  (bluetooth-dropdown-content))
